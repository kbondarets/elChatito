# Скопируйте этот файл в .env и вставьте свои значения.
# .env в git не попадает (см. .gitignore) — ключ останется только у вас.
apimira_api_key=am-ВАШ_КЛЮЧ
apimira_base_url=https://apimira.com/v1

# Запасной DNS через DNS-over-HTTPS (DoH).
# Если провайдер «глушит» обычный DNS, приложение всё равно найдёт apimira.com.
# Обычно менять здесь ничего не нужно — эти строки для настройки.
# doh_enabled=1
# doh_server=https://1.1.1.1/dns-query
